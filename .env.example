# Development only: replace before any shared deployment. Never use NEXT_PUBLIC_.
POSTGRES_USER=rack_app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=gpu_rack
DATABASE_URL=postgresql://rack_app:replace-with-local-password@127.0.0.1:55432/gpu_rack?schema=public
# Tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql://rack_app:replace-with-local-password@127.0.0.1:55432/gpu_rack_test?schema=public
# Local master-data writes require this secret in Authorization: Bearer <token>.
MANUFACTURING_API_TOKEN=replace-with-at-least-32-random-characters
